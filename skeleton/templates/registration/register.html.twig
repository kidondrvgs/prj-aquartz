{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}
    <div class="auth-container">
        <div class="auth-card">
            <h1>Créer un compte</h1>
            <p class="auth-subtitle">Renseignez vos informations pour déposer et suivre vos demandes.</p>

            {{ form_errors(registrationForm) }}

            {{ form_start(registrationForm, {attr: {class: 'auth-form'}}) }}
            <div class="form-row-double">
                <div class="form-group">
                    {{ form_label(registrationForm.lastName, 'Nom') }}
                    {{ form_widget(registrationForm.lastName, {attr: {placeholder: 'Dupont'}}) }}
                    {{ form_errors(registrationForm.lastName) }}
                </div>

                <div class="form-group">
                    {{ form_label(registrationForm.firstName, 'Prénom') }}
                    {{ form_widget(registrationForm.firstName, {attr: {placeholder: 'Jean'}}) }}
                    {{ form_errors(registrationForm.firstName) }}
                </div>
            </div>

            <div class="form-group">
                {{ form_label(registrationForm.email, 'Adresse e-mail') }}
                {{ form_widget(registrationForm.email, {attr: {placeholder: 'nom@exemple.fr'}}) }}
                {{ form_errors(registrationForm.email) }}
            </div>

            <div class="form-row-double">
                <div class="form-group">
                    {{ form_label(registrationForm.plainPassword.first, 'Mot de passe') }}
                    {{ form_widget(registrationForm.plainPassword.first, {attr: {placeholder: '8 caractères minimum'}}) }}
                    {{ form_errors(registrationForm.plainPassword.first) }}
                </div>

                <div class="form-group">
                    {{ form_label(registrationForm.plainPassword.second, 'Confirmation') }}
                    {{ form_widget(registrationForm.plainPassword.second, {attr: {placeholder: 'Répétez le mot de passe'}}) }}
                    {{ form_errors(registrationForm.plainPassword.second) }}
                </div>
            </div>

            <button type="submit" class="btn-submit">Créer mon compte</button>
            {{ form_end(registrationForm) }}

            <p class="auth-link">
                Déjà un compte ? <a href="{{ path('app_login') }}">Se connecter</a>
            </p>
        </div>
    </div>
{% endblock %}
