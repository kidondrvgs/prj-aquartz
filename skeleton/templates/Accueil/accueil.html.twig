{% extends 'base.html.twig' %}

{% block title %}Accueil - AQUARTZ Terrassement{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/accueil.css') }}?v=20261016-4">
{% endblock %}

{% block body %}

    {# ================= HERO ================= #}
    <section class="hero">
        <div class="hero-content">
            <p class="hero-eyebrow">Entreprise de terrassement · Normandie</p>

            <h1 class="hero-title">
                Terrassement, VRD et <span>aménagements</span> extérieurs
            </h1>

            <p class="hero-text">
                AQUARTZ – TERRASSEMENT accompagne particuliers et professionnels,
                de la préparation du terrain jusqu'à la finition : décaissement,
                tranchées, assainissement, plateformes.
            </p>

            <div class="hero-buttons">
                <a href="{{ path('app_prestations') }}" class="btn btn-yellow">Voir nos prestations</a>
                <a href="{{ path('app_nouvelle_demande') }}" class="btn btn-white">Faire une demande</a>
            </div>
        </div>

        <div class="hero-image">
            <img src="{{ asset('images/hero-terrassement.jpg') }}" alt="Pelle mécanique sur chantier de terrassement">
        </div>
    </section>


    {# ================= PRESENTATION ================= #}
    <section class="about">
        <div class="about-text">
            <h2>Un savoir-faire de terrain depuis 2004</h2>
            <p>
                Notre équipe intervient sur des chantiers de toutes tailles avec
                du matériel récent et des conducteurs d'engins expérimentés.
                Devis clair, délais tenus, terrain remis propre.
            </p>
        </div>

        <div class="about-stats">
            <div class="stat">
                <span class="stat-number">20+</span>
                <span class="stat-label">ans d'expérience</span>
            </div>
            <div class="stat">
                <span class="stat-number">1 200</span>
                <span class="stat-label">chantiers réalisés</span>
            </div>
            <div class="stat">
                <span class="stat-number">15</span>
                <span class="stat-label">collaborateurs</span>
            </div>
        </div>
    </section>


    {# ================= PRESTATIONS ================= #}
    <section class="prestations" id="prestations">
        <div class="prestations-header">
            <h2>Nos prestations</h2>
            <a href="{{ path('app_prestations') }}" class="link-arrow">Voir toutes les prestations →</a>
        </div>

        
        <div class="carrousel-commandes" hidden>
            <button type="button" class="carrousel-bouton" id="prestation-precedente" aria-label="Prestations précédentes" aria-controls="carrousel-prestations">←</button>
            <button type="button" class="carrousel-bouton" id="prestation-suivante" aria-label="Prestations suivantes" aria-controls="carrousel-prestations">→</button>
        </div>

        <div class="prestations-grid" id="carrousel-prestations" tabindex="0" role="region" aria-label="Nos prestations">

            {# Une carte par prestation #}
            {% for prestation in prestations %}
                <article class="card">
                    <div class="card-image">
                        <img src="{{ asset('images/' ~ prestation.slug ~ '.jpg') }}" alt="{{ prestation.title }}">
                    </div>
                    <div class="card-body">
                        <h3>{{ prestation.title }}</h3>
                        <p>{{ prestation.description }}</p>
                        <a href="{{ path('app_prestations') }}" class="link-arrow">En savoir plus →</a>
                    </div>
                </article>
            {% endfor %}
        </div>
    </section>

    <script src="{{ asset('js/accueil.js') }}?v=20261016-4" defer></script>


    {# ================= CTA ================= #}
    <section class="cta" id="demande">
        <p>Un projet de terrassement ? Décrivez-le en ligne, nous vous répondons sous 48 h.</p>
        <a href="{{ path('app_nouvelle_demande') }}" class="btn btn-black">Faire une demande</a>
    </section>

{% endblock %}
